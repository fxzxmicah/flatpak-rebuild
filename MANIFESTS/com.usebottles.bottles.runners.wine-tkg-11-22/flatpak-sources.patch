diff --git a/wine-tkg-git/non-makepkg-build.sh b/wine-tkg-git/non-makepkg-build.sh
index 7834f205..5ad9ff70 100755
--- a/wine-tkg-git/non-makepkg-build.sh
+++ b/wine-tkg-git/non-makepkg-build.sh
@@ -86,6 +86,22 @@ pkgver() {
 }
 
 _src_init() {
+  # Flatpak Builder supplies immutable, pinned Git sources before the sandbox starts.
+  if [ -n "${_FLATPAK_SOURCE_ROOT:-}" ]; then
+    _winesrcdir="wine-git"
+    _stgsrcdir="wine-staging-git"
+    for source in wine wine-staging; do
+      test -d "${_FLATPAK_SOURCE_ROOT}/${source}/.git" || {
+        error "Missing Flatpak Git source: ${source}"
+        return 1
+      }
+    done
+    git clone --no-hardlinks --local "${_FLATPAK_SOURCE_ROOT}/wine" "${srcdir}/${_winesrcdir}"
+    git clone --no-hardlinks --local "${_FLATPAK_SOURCE_ROOT}/wine-staging" "${srcdir}/${_stgsrcdir}"
+    find "${_where}"/wine-tkg-patches -type f -name '*.conf' -not -path '*hotfixes*' -exec cp -n {} "${_where}" \;
+    return
+  fi
+
   # Wine source
   if [ "$_github_mirrorsrc" = "true" ]; then
     _winesrcdir="wine-mirror-git"
@@ -300,11 +316,7 @@ build_wine_tkg() {
   else
     _nomakepkg_pkgname="${pkgname}-${pkgver}"
   fi
-  if [ -z "$_nomakepkg_prefix_path" ]; then
-    local _prefix="$_where/${_nomakepkg_pkgname}"
-  else
-    local _prefix="${_nomakepkg_prefix_path}/${_nomakepkg_pkgname}"
-  fi
+  local _prefix="${FLATPAK_DEST:-${_nomakepkg_prefix_path:-${_where}}/${_nomakepkg_pkgname}}"
 
   if [ "$_NOLIB32" = "true" ] || ( [[ "$_custom_wine_source" = *"ValveSoftware"* ]] && [[ "$_plain_version" = *_11.0 ]] ); then # Valve: Maybe switch globally for wine 11+?
     local _lib32name="lib"
